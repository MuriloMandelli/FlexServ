# Copie este arquivo para ".env" (na mesma pasta) e preencha os valores.
# O .env nunca vai para o Git.

# Conexão com o banco no Neon (painel do Neon > Connection string)
DATABASE_URL=postgresql://usuario:senha@host.neon.tech/banco?sslmode=require

# Porta da API local (o proxy do front aponta para 3333)
PORT=3333

# Chave que assina os tokens de login. Use um texto longo e aleatório, por exemplo:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
