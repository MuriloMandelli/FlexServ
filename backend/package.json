{
  "name": "flexserv-backend",
  "version": "0.1.0",
  "description": "Back-end do FlexServ (sistema de gestao de Ordens de Servico para a TecFlex)",
  "main": "src/index.ts",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "ts-node-dev --transpile-only src/db/seed.ts",
    "db:seed-demo": "ts-node-dev --transpile-only src/db/seed-demo.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.3",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "ws": "^8.18.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/ws": "^8.5.13",
    "drizzle-kit": "^0.31.11",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
